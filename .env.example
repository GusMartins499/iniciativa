# Conexão do Postgres no Neon (string "pooled" do painel do Neon).
DATABASE_URL=

# Better Auth: segredo aleatório (gere com `openssl rand -base64 32`) e URL pública do app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# OAuth do Google (Google Cloud Console → APIs e serviços → Credenciais).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: nível de log do pino (fatal, error, warn, info, debug, trace ou silent). Padrão: info.
LOG_LEVEL=

# Opcional, só para testes: branch "test" do Neon (pooled) usada pelo teste de concorrência.
# O schema dela é apagado e recriado a cada execução. Nunca use a branch dev nem a de produção.
TEST_DATABASE_URL=

# Opcional, só para testes e2e: o playwright.config.ts já define (wsproxy do e2e/compose.yaml).
# Endereço sem protocolo do wsproxy do Neon na frente de um Postgres comum. Nunca em produção.
DATABASE_WS_PROXY=

# Opcional: traces por OTLP (GUIDELINES.md § Tracing). Sem o endpoint, a telemetria fica desligada.
# Endpoint base do OTLP (o app acrescenta /v1/traces).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Segredo: headers no formato chave=valor separados por vírgula, com o valor codificado em URL.
OTEL_EXPORTER_OTLP_HEADERS=
# Nome do serviço nos traces. Padrão: iniciativa.
OTEL_SERVICE_NAME=
